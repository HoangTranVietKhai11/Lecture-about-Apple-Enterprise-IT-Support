DATABASE_URL="postgresql://user:password@localhost:5432/dep110_db?schema=public"

# Next.js Public Config
NEXT_PUBLIC_APP_NAME="Apple DEP110 Certified IT Professional Hub"
NEXT_PUBLIC_APP_VERSION="1.0.0"
