        <mxCell id="DZxEVU7cwkrGuVkJH6dp-18" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Chú thích&lt;/h1&gt;&lt;div&gt;+&lt;b&gt; Enterprise&lt;/b&gt;: Doanh nghiệp&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;+&lt;b&gt; IT-Administrator&lt;/b&gt;: Người quản trị hệ thống&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;+&lt;b&gt; Apple Business Manager&lt;/b&gt;: Nền tảng quản lý thiết bị và dịch vụ Apple của tổ&amp;nbsp; chức&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;+ &lt;b&gt;MDM Server&lt;/b&gt;: Hệ thống quản trị thiết bị&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;+ &lt;b&gt;Jamf Pro&lt;/b&gt;: Một giải pháp MDM chuyên cho Apple&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;+ &lt;b&gt;End User&lt;/b&gt;: Người sử dụng thiết bị&lt;/div&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="300" width="270" x="-40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="DZxEVU7cwkrGuVkJH6dp-20" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Lab 01&lt;/font&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt; Thiết kế Apple Ecosystem cho doanh nghiệp ABC.&lt;/font&gt;&lt;p&gt;&lt;/p&gt;&lt;/h1&gt;&lt;h2&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Yêu cầu&lt;/font&gt;&lt;/h2&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;p&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Công ty ABC có:&lt;/font&gt;&lt;/p&gt;&lt;div&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th&gt;&lt;p&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Phòng ban&lt;/font&gt;&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Nhân viên&lt;/font&gt;&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Thiết bị&lt;/font&gt;&lt;/p&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;IT&lt;/font&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;10&lt;/font&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;5 MacBook, 5 iPhone&lt;/font&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Kế toán&lt;/font&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;20&lt;/font&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;10 iPad, 10 iPhone&lt;/font&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Kinh doanh&lt;/font&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;30&lt;/font&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;20 iPhone, 10 iPad&lt;/font&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;p&gt;&lt;font style=&quot;font-size: 26px;&quot;&gt;Tổng cộng 60 nhân viên và 60 thiết bị.&lt;/font&gt;&lt;/p&gt;&lt;/h1&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
